{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "x-original-url",
          "value": "/api/$1"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/products/:slug",
      "destination": "/product-detail.html"
    },
    {
      "source": "/packages/:slug",
      "destination": "/packages.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/projects.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/packages",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/checkout",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/#solutions",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/",
      "permanent": true
    }
  ]
}
