# DEVICE PRO — Environment Configuration Template
# Duplicate this file to .env and provide your production variables

# Server Port
PORT=3000
NODE_ENV=development

# Database Configuration (Dual Engine)
# Leave blank to run on local SQLite engine (data/products.db).
# Provide your MongoDB Atlas cluster URI to seamlessly switch to MongoDB Atlas:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/devicepro?retryWrites=true&w=majority
MONGODB_DB_NAME=devicepro

# Staff Administrative Access
ADMIN_DEFAULT_PASSWORD=
SESSION_SECRET=

# Payment Gateway (Stage 15)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Corporate Notifications & SMTP Mailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_NOTIFICATION_EMAIL=info@devicepro.com
