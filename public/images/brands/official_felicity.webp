  position: relative;
  overflow:hidden;
}

#uc_ue_unfold_elementor_83b9349 .uf_overlayuc_ue_unfold_elementor_83b9349{
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    background: -moz-linear-gradient(0deg, #ffffff) 10%, rgba(255, 255, 255, 0) 100%);
    background: -webkit-linear-gradient(0deg, #ffffff 10%, rgba(255, 255, 255, 0) 100%);
