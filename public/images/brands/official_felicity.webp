<style>/* widget: Animated Ripples Background */

#uc_animated_ripples_bg_addon11672ripple-background
{
  position:absolute;
  top:0px;
  bottom:0px;
  right:0px;
  left:0px;
  overflow:hidden;
}
#uc_animated_ripples_bg_addon11672ripple-background .circle{
  position: absolute;
  border-radius: 50%;
  background: rgba(203, 203, 203, 0.7);
  animation: ripple 15s infinite;
  box-shadow: 0px 0px 1px 0px #508fb9;
}

#uc_animated_ripples_bg_addon11672ripple-background .small{
  width: 200px;
  height: 200px;
  right: -100px;
  top: -100px;
}

#uc_animated_ripples_bg_addon11672ripple-background .medium{
  width: 400px;
  height: 400px;
  right: -200px;
  top: -200px;
}

#uc_animated_ripples_bg_addon11672ripple-background .large{
  width: 600px;
  height: 600px;
  right: -300px;
  top: -300px;
}

#uc_animated_ripples_bg_addon11672ripple-background .xlarge{
  width: 800px;
  height: 800px;
  right: -400px;
  top: -400px;
}

#uc_animated_ripples_bg_addon11672ripple-background .xxlarge{
  width: 1000px;
  height: 1000px;
  right: -500px;
  top: -500px;
}

#uc_animated_ripples_bg_addon11672ripple-background .shade1{
  opacity: 0.2;
}
#uc_animated_ripples_bg_addon11672ripple-background .shade2{
  opacity: 0.5;
}

#uc_animated_ripples_bg_addon11672ripple-background .shade3{
  opacity: 0.7;
}

#uc_animated_ripples_bg_addon11672ripple-background .shade4{
  opacity: 0.8;
}

#uc_animated_ripples_bg_addon11672ripple-background .shade5{
  opacity: 0.9;
}

@keyframes ripple{
  0%{
    transform: scale(0.8);
  }
  
  50%{
    transform: scale(1.2);
  }
  
  100%{
