<template id="tp-language" data-tp-language="en_US"></template><script type="speculationrules">{"prefetch":[{"source":"document","where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":["/wp-*.php","/wp-admin/*","/wp-content/uploads/*","/wp-content/*","/wp-content/plugins/*","/wp-content/themes/astra/*","/*\\?(.+)"]}},{"not":{"selector_matches":"a[rel~=\"nofollow\"]"}},{"not":{"selector_matches":".no-prefetch, .no-prefetch a"}}]},"eagerness":"conservative"}]}</script> <script>window.ecCaptchaPage = { page_id: 7, page_nonce: "f08301b77b", ajax_url: "https:\/\/www.felicitysolar.com\/wp-admin\/admin-ajax.php", turnstile_sitekey: "0x4AAAAAAB6p0KC98HofeY-f", email_verification_enabled: true, resend_cooldown: 60 };</script> <script src="data:text/javascript;base64," defer></script> <script>(function(){
  if (window._ec_turnstile_ver_bootstrapped) return;
  window._ec_turnstile_ver_bootstrapped = true;

  // util
  function tryParseJSON(text){ try { return JSON.parse(text); } catch(e){ return null; } }

  function normalizeEmail(email) {
    return String(email || '').trim().toLowerCase();
  }

  function replaceEmailToken(text, email) {
    return String(text || '').replace(/\{.*?\}/, email || '');
  }

  function looksLikeEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalizeEmail(email));
  }

  function getFormNameValue(form) {
    var nameInput = form.querySelector('input[name="name"], input[name="your-name"], input[name="fullname"], input[name="full_name"]');
    return nameInput ? String(nameInput.value || '').trim() : '';
  }

  function getFormEmailValue(form) {
    var emailInput = form.querySelector('input[type="email"], input[name="email"], input[name="your-email"]');
    if (!emailInput) emailInput = form.querySelector('input[type="email"]');
    return emailInput ? normalizeEmail(emailInput.value) : '';
  }

  function hashString(input) {
    var str = String(input || '');
    var hash = 0;
    for (var i = 0; i < str.length; i++) {
      hash = ((hash << 5) - hash) + str.charCodeAt(i);
      hash |= 0;
    }
    return String(hash >>> 0);
  }

  function getFormStorageScope(form) {
    var scope = '';
    if (form) {
      scope = form.getAttribute('id') || form.getAttribute('name') || form.getAttribute('action') || form.getAttribute('class') || '';
      if (!scope) {
        var box = form.closest('[data-id],[data-elementor-id]');
        if (box) scope = box.getAttribute('data-id') || box.getAttribute('data-elementor-id') || '';
      }
    }
    if (!scope) scope = window.location.pathname || 'form';
    return scope;
  }

  function getVerificationStorageKey(form, email) {
    return 'ec_verification_state:' + String(window.ecCaptchaPage.page_id || 0) + ':' + hashString(getFormStorageScope(form) + '|' + normalizeEmail(email));
  }

  function isEmailVerificationEnabled() {
    return !!(window.ecCaptchaPage && window.ecCaptchaPage.email_verification_enabled);
  }

  function getResendCooldown() {
    return Number((window.ecCaptchaPage && window.ecCaptchaPage.resend_cooldown) || 60);
  }

  function setHiddenInput(form, name, value) {
    var old = form.querySelector('input[name="' + name + '"]');
    if (old && old.parentNode) old.parentNode.removeChild(old);
    var inp = document.createElement('input');
    inp.type = 'hidden';
    inp.name = name;
    inp.value = value;
    form.appendChild(inp);
  }

  function loadCachedVerification(form, email) {
    var normalizedEmail = normalizeEmail(email);
    if (!normalizedEmail || !window.localStorage) return null;
    var storageKey = getVerificationStorageKey(form, normalizedEmail);
    try {
      var raw = window.localStorage.getItem(storageKey);
      if (!raw) return null;
      var cached = tryParseJSON(raw);
      if (!cached || !cached.verification_id || !cached.expires_at) {
        window.localStorage.removeItem(storageKey);
        return null;
      }
      if (normalizeEmail(cached.email) !== normalizedEmail || Number(cached.expires_at) <= Math.floor(Date.now() / 1000)) {
        window.localStorage.removeItem(storageKey);
        return null;
      }
      cached.storage_key = storageKey;
      cached.last_sent_at = Number(cached.last_sent_at || 0);
      cached.resend_available_at = Number(cached.resend_available_at || 0);
      return cached;
    } catch(e) {
      return null;
    }
  }

  function saveCachedVerification(form, email, payload) {
    var normalizedEmail = normalizeEmail(email);
    if (!normalizedEmail || !window.localStorage || !payload || !payload.verification_id) return null;
    var storageKey = getVerificationStorageKey(form, normalizedEmail);
    var expiresAt = Number(payload.expires_at || 0);
    if (!expiresAt && payload.expires_in) {
      expiresAt = Math.floor(Date.now() / 1000) + Number(payload.expires_in);
    }
    if (!expiresAt) {
      expiresAt = Math.floor(Date.now() / 1000) + 300;
    }
    var cached = {
      verification_id: String(payload.verification_id),
      email: normalizedEmail,
      expires_at: expiresAt,
      last_sent_at: Number(payload.last_sent_at || 0),
      resend_available_at: Number(payload.resend_available_at || 0),
      storage_key: storageKey
    };
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(cached));
    } catch(e) {}
    return cached;
  }

  function clearCachedVerification(form, email, cached) {
    if (!window.localStorage) return;
    try {
      if (cached && cached.storage_key) {
        window.localStorage.removeItem(cached.storage_key);
        return;
      }
      var normalizedEmail = normalizeEmail(email);
      if (!normalizedEmail) return;
      window.localStorage.removeItem(getVerificationStorageKey(form, normalizedEmail));
    } catch(e) {}
  }

  function setButtonPending(button, isPending, pendingLabel, idleLabel) {
    if (!button) return;
    if (!button.dataset.idleLabel) {
      button.dataset.idleLabel = idleLabel || button.textContent || '';
    } else if (idleLabel) {
      button.dataset.idleLabel = idleLabel;
    }

    if (isPending) {
      button.dataset.pending = '1';
      button.disabled = true;
      button.textContent = pendingLabel || button.dataset.idleLabel;
      button.style.opacity = '0.78';
      button.style.transform = 'translateY(1px)';
      button.style.cursor = 'wait';
      button.style.boxShadow = 'none';
      return;
    }

    button.dataset.pending = '0';
    button.disabled = false;
    button.textContent = button.dataset.idleLabel || idleLabel || button.textContent;
    button.style.opacity = '1';
    button.style.transform = '';
    button.style.cursor = 'pointer';
    if (button.id === 'ec-verify-btn') {
      button.style.boxShadow = '0 4px 12px rgba(6,8,20,0.08)';
    }
  }

  function findSubmitterCandidate(node) {
    while (node && node.nodeType === 1) {
      var tag = node.nodeName;
      if (tag === 'BUTTON') {
        var type = (node.getAttribute('type') || 'submit').toLowerCase();
        if (type === 'submit') return node;
      }
      if (tag === 'INPUT') {
        var inputType = (node.getAttribute('type') || '').toLowerCase();
        if (inputType === 'submit' || inputType === 'image') return node;
      }
      node = node.parentNode;
    }
    return null;
  }

  function submitVerifiedForm(form) {
    var submitter = form._ecPendingSubmitter || form._ecLastSubmitter || null;
    form._ecPendingSubmitter = null;

    // Prefer the browser-native submission path so Elementor keeps its Ajax/popup lifecycle.
    if (typeof form.requestSubmit === 'function') {
      if (submitter && submitter.form === form && !submitter.disabled) {
        form.requestSubmit(submitter);
      } else {
        form.requestSubmit();
      }
      return;
    }

    if (submitter && submitter.form === form && !submitter.disabled && typeof submitter.click === 'function') {
      submitter.click();
      return;
    }

    form.submit();
  }

  // load Turnstile script on demand
  function loadTurnstileScript() {
    if (window.turnstile && window.turnstile.render) return Promise.resolve();
    if (window._ec_turnstile_script_loading) return window._ec_turnstile_script_loading;
    var p = new Promise(function(resolve, reject){
      var s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      s.async = true;
      s.defer = true;
      s.onload = function(){ resolve(); };
      s.onerror = function(){ reject(new Error('Turnstile load failed')); };
      document.head.appendChild(s);
    });
    window._ec_turnstile_script_loading = p;
    return p;
  }

  // get texts from PHP-provided dictionary, choose by browser language
  function getTexts() {
    try {
      var dict = window._ec_texts || {};
      var lang = (navigator.language || navigator.userLanguage || 'en').slice(0,2);
      if ( dict[lang] ) return dict[lang];
      if ( lang.indexOf('zh') === 0 && dict['zh'] ) return dict['zh'];
      return dict['en'] || {};
    } catch(e) {
      return window._ec_texts && window._ec_texts.en ? window._ec_texts.en : {};
    }
  }

  // build modal with container for turnstile widget and code input area (initially code input hidden)
  function buildModal() {
    var texts = getTexts();
    var old = document.querySelector('.ec-vcode-modal');
    if (old) try { old.parentNode.removeChild(old); } catch(e){}
    var modal = document.createElement('div');
    modal.className = 'ec-vcode-modal';
    modal.setAttribute('role','dialog');
    modal.setAttribute('aria-modal','true');
    modal.style.cssText = 'display:flex;position:fixed;z-index:200000;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,0.45);align-items:center;justify-content:center;padding:20px;';

    var vbox = document.createElement('div');
    vbox.className = 'ec-vbox';
    // position:relative so the close X (absolute) can be placed inside
    vbox.style.cssText = 'position:relative;max-width:520px;width:100%;background:#fff;padding:20px;border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,0.25);font-family:Arial,Helvetica,sans-serif;color:#222;';

    // top-right close (small X)
    var closeBtn = document.createElement('button');
    closeBtn.type = 'button';
    closeBtn.setAttribute('aria-label', texts.cancel_btn || 'Close');
    closeBtn.innerHTML = '&#x2715;'; // ×
    closeBtn.style.cssText = 'position:absolute;right:12px;top:12px;width:34px;height:34px;border-radius:8px;border:0;background:transparent;color:#374151;font-size:18px;cursor:pointer;';
    closeBtn.title = texts.cancel_btn || 'Close';
    vbox.appendChild(closeBtn);

    // title
    var title = document.createElement('div');
    title.style.cssText = 'font-size:18px;font-weight:700;margin-bottom:14px;color:#111;';
    title.textContent = texts.title;
    vbox.appendChild(title);

    // Turnstile area: centered container
    var turnWrap = document.createElement('div');
    turnWrap.id = 'ec-turnstile-wrap';
    turnWrap.style.cssText = 'display:flex;justify-content:center;padding:14px 0 8px 0;min-height:72px;';
    vbox.appendChild(turnWrap);

    // small helper / status area
    var sentNote = document.createElement('div');
    sentNote.id = 'ec-sent-note';
    sentNote.style.cssText = 'display:none;margin:12px 0;padding:10px;border-radius:8px;background:#f7f9fc;color:#0b2a66;font-size:14px;';
    vbox.appendChild(sentNote);

    // code input area (hidden initially)
    var codeArea = document.createElement('div');
    codeArea.id = 'ec-code-area';
    codeArea.style.cssText = 'display:none;margin-top:10px;';
    var codeInput = document.createElement('input');
    codeInput.type = 'text';
    codeInput.id = 'ec-code-input';
    codeInput.placeholder = texts.input_placeholder;
    codeInput.style.cssText = 'width:100%;padding:10px;border:1px solid #e6e9ef;border-radius:8px;font-size:15px;box-sizing:border-box;';
    codeArea.appendChild(codeInput);

    var controls = document.createElement('div');
    controls.style.cssText = 'display:flex;gap:10px;justify-content:flex-end;margin-top:10px;';

    var resendBtn = document.createElement('button');
    resendBtn.type = 'button';
    resendBtn.id = 'ec-resend-btn';
    resendBtn.textContent = texts.resend_btn || 'Resend Email';
    resendBtn.style.cssText = 'padding:10px 12px;border-radius:8px;border:1px solid #bfdbfe;background:#eff6ff;color:#1d4ed8;cursor:pointer;font-weight:600;transition:all .18s ease;';

    var verifyBtn = document.createElement('button');
    verifyBtn.type = 'button';
    verifyBtn.id = 'ec-verify-btn';
    verifyBtn.textContent = texts.verify_btn;
    verifyBtn.style.cssText = 'padding:10px 14px;border-radius:8px;border:0;background:linear-gradient(90deg,#2563eb,#06b6d4);color:#fff;font-weight:700;cursor:pointer;box-shadow:0 4px 12px rgba(6,8,20,0.08);transition:all .18s ease;min-width:150px;';

    var cancelBtn = document.createElement('button');
    cancelBtn.type = 'button';
    cancelBtn.id = 'ec-vcancel';
    cancelBtn.textContent = texts.cancel_btn;
    cancelBtn.style.cssText = 'padding:10px 12px;border-radius:8px;border:1px solid #d1d5db;background:#fff;color:#374151;cursor:pointer;transition:all .18s ease;';

    controls.appendChild(resendBtn);
    controls.appendChild(cancelBtn);
    controls.appendChild(verifyBtn);
    codeArea.appendChild(controls);

    var resendInfo = document.createElement('div');
    resendInfo.id = 'ec-resend-info';
    resendInfo.style.cssText = 'margin-top:10px;font-size:12px;color:#6b7280;display:none;text-align:right;';
    codeArea.appendChild(resendInfo);

    vbox.appendChild(codeArea);

    var errorDiv = document.createElement('div');
    errorDiv.id = 'ec-verror';
    errorDiv.style.cssText = 'color:#b91c1c;margin-top:12px;display:none;font-size:13px;';
    vbox.appendChild(errorDiv);

    // note: removed the fixed footer "This is an automated system message..." per request

    modal.appendChild(vbox);
    document.body.appendChild(modal);

    // close handlers
    closeBtn.addEventListener('click', function(){
      if (modal._ecResendTimer) window.clearInterval(modal._ecResendTimer);
      try { modal.parentNode.removeChild(modal); } catch(e){}
    });
    cancelBtn.addEventListener('click', function(){
      if (modal._ecResendTimer) window.clearInterval(modal._ecResendTimer);
      try { modal.parentNode.removeChild(modal); } catch(e){}
    });

    return modal;
  }

  function showError(modal, msg) {
    var el = modal.querySelector('#ec-verror');
    if (el) { el.style.display = 'block'; el.textContent = msg; }
  }

  function clearError(modal) {
    var el = modal.querySelector('#ec-verror');
    if (el) { el.style.display = 'none'; el.textContent = ''; }
  }

  // show temporary message in sent note
  function showSentNote(modal, text) {
    var el = modal.querySelector('#ec-sent-note');
    if (el) { el.style.display = 'block'; el.textContent = text; }
  }

  function showCodeEntryState(modal, email, noteText) {
    var wrap = modal.querySelector('#ec-turnstile-wrap');
    var codeArea = modal.querySelector('#ec-code-area');
    var codeInput = modal.querySelector('#ec-code-input');
    var resendBtn = modal.querySelector('#ec-resend-btn');
    var resendInfo = modal.querySelector('#ec-resend-info');
    if (wrap) {
      wrap.innerHTML = '';
      wrap.style.display = 'none';
    }
    if (codeArea) codeArea.style.display = 'block';
    if (resendBtn) resendBtn.style.display = isEmailVerificationEnabled() ? '' : 'none';
    if (resendInfo) resendInfo.style.display = isEmailVerificationEnabled() ? 'block' : 'none';
    showSentNote(modal, noteText || replaceEmailToken(getTexts().sent, email));
    if (codeInput) {
      window.setTimeout(function(){ try { codeInput.focus(); } catch(e){} }, 30);
    }
  }

  function bindVerifyButton(modal, form, emailVal, cachedState) {
    var texts = getTexts();
    var vbtn = modal.querySelector('#ec-verify-btn');
    var codeInput = modal.querySelector('#ec-code-input');
    if (!vbtn || !codeInput) return;
    setButtonPending(vbtn, false, texts.verify_loading, texts.verify_btn);

    var submitCode = function() {
      var codeVal = codeInput.value ? codeInput.value.trim() : '';
      if (!codeVal) {
        showError(modal, texts.error_generic);
        return;
      }
      clearError(modal);
      setButtonPending(vbtn, true, texts.verify_loading, texts.verify_btn);
      checkVerification(modal.dataset.ecVerificationId, codeVal, form, modal, emailVal, cachedState);
    };

    vbtn.onclick = submitCode;
    codeInput.onkeydown = function(evt) {
      if ((evt.key || '') === 'Enter') {
        evt.preventDefault();
        submitCode();
      }
    };
  }

  function refreshResendUi(modal, cachedState) {
    var texts = getTexts();
    var resendBtn = modal.querySelector('#ec-resend-btn');
    var resendInfo = modal.querySelector('#ec-resend-info');
    if (!resendBtn || !resendInfo) return;

    if (!cachedState || !cachedState.verification_id) {
      setButtonPending(resendBtn, false, texts.resend_loading, texts.resend_btn);
      resendBtn.disabled = true;
      resendInfo.style.display = 'none';
      return;
    }

    resendInfo.style.display = 'block';
    if (resendBtn.dataset.pending === '1') {
      return;
    }
    var now = Math.floor(Date.now() / 1000);
    var availableAt = Number(cachedState.resend_available_at || 0);
    var secondsLeft = Math.max(0, availableAt - now);
    if (secondsLeft > 0) {
      setButtonPending(resendBtn, false, texts.resend_loading, texts.resend_btn);
      resendBtn.disabled = true;
      resendInfo.textContent = String(texts.resend_wait || 'Resend available in {seconds}s').replace('{seconds}', String(secondsLeft));
      return;
    }

    setButtonPending(resendBtn, false, texts.resend_loading, texts.resend_btn);
    resendBtn.disabled = false;
    resendInfo.textContent = '';
  }

  function bindResendButton(modal, form, emailVal, cachedState) {
    var resendBtn = modal.querySelector('#ec-resend-btn');
    if (!resendBtn || !isEmailVerificationEnabled()) return;

    modal._ecCachedState = cachedState || null;
    if (modal._ecResendTimer) window.clearInterval(modal._ecResendTimer);
    refreshResendUi(modal, modal._ecCachedState);
    modal._ecResendTimer = window.setInterval(function(){
      if (!document.body.contains(modal)) {
        window.clearInterval(modal._ecResendTimer);
        modal._ecResendTimer = null;
        return;
      }
      refreshResendUi(modal, modal._ecCachedState);
    }, 1000);

    resendBtn.onclick = function() {
      resendVerification(form, modal, emailVal, modal._ecCachedState);
    };
  }

  function resendVerification(form, modal, emailVal, cachedState) {
    var texts = getTexts();
    var resendBtn = modal.querySelector('#ec-resend-btn');
    if (!cachedState || !cachedState.verification_id) {
      showError(modal, texts.error_send);
      return;
    }

    var data = new FormData();
    data.append('action', 'ec_resend_verification');
    data.append('ec_page_nonce', window.ecCaptchaPage.page_nonce || '');
    data.append('page_id', window.ecCaptchaPage.page_id || 0);
    data.append('verification_id', cachedState.verification_id);
    data.append('to_email', emailVal);
    data.append('to_name', getFormNameValue(form));

    clearError(modal);
    setButtonPending(resendBtn, true, texts.resend_loading, texts.resend_btn);

    fetch(window.ecCaptchaPage.ajax_url, {
      method: 'POST',
      credentials: 'same-origin',
      body: data
    }).then(function(res){ return res.json(); }).then(function(json){
      if (!json) {
        setButtonPending(resendBtn, false, texts.resend_loading, texts.resend_btn);
        showError(modal, texts.error_send);
        refreshResendUi(modal, modal._ecCachedState);
        return;
      }
      if (!json.success) {
        var errorData = json.data || {};
        if (errorData.error_code === 'expired') {
          clearCachedVerification(form, emailVal, cachedState);
        }
        if (errorData.resend_available_at && modal._ecCachedState) {
          modal._ecCachedState.resend_available_at = Number(errorData.resend_available_at);
        }
        setButtonPending(resendBtn, false, texts.resend_loading, texts.resend_btn);
        refreshResendUi(modal, modal._ecCachedState);
        var msg = errorData.message || json.message || texts.error_send;
        showError(modal, msg);
        return;
      }

      clearError(modal);
      modal._ecCachedState = saveCachedVerification(form, emailVal, json.data || {}) || modal._ecCachedState;
      modal.dataset.ecVerificationId = (json.data && json.data.verification_id) ? json.data.verification_id : modal.dataset.ecVerificationId;
      showSentNote(modal, replaceEmailToken(texts.resent || texts.sent, emailVal));
      setButtonPending(resendBtn, false, texts.resend_loading, texts.resend_btn);
      refreshResendUi(modal, modal._ecCachedState);
    }).catch(function(){
      setButtonPending(resendBtn, false, texts.resend_loading, texts.resend_btn);
      showError(modal, texts.error_send);
      refreshResendUi(modal, modal._ecCachedState);
    });
  }

  function openCodeEntryModal(form, emailVal, cachedState) {
    var texts = getTexts();
    var modal = buildModal();
    modal.dataset.ecVerificationId = cachedState && cachedState.verification_id ? cachedState.verification_id : '';
    showCodeEntryState(modal, emailVal, replaceEmailToken(texts.reused || texts.sent, emailVal));
    bindVerifyButton(modal, form, emailVal, cachedState);
    bindResendButton(modal, form, emailVal, cachedState);
  }

  function verifyTurnstileOnly(turnstileToken, form, modal) {
    var texts = getTexts();
    var data = new FormData();
    data.append('action', 'ec_verify_turnstile');
    data.append('ec_page_nonce', window.ecCaptchaPage.page_nonce || '');
    data.append('page_id', window.ecCaptchaPage.page_id || 0);
    data.append('turnstile_token', turnstileToken);

    fetch(window.ecCaptchaPage.ajax_url, {
      method: 'POST',
      credentials: 'same-origin',
      body: data
    }).then(function(res){ return res.json(); }).then(function(json){
      if (!json || !json.success || !json.data || !json.data.turnstile_id) {
        var msg = (json && json.data && json.data.message) ? json.data.message : texts.solving_error;
        showError(modal, msg);
        return;
      }

      try {
        form._ecAllowVerifiedSubmit = true;
        setHiddenInput(form, 'ec_turnstile_verified_id', json.data.turnstile_id);
        if (modal._ecResendTimer) window.clearInterval(modal._ecResendTimer);
        try { modal.parentNode.removeChild(modal); } catch(e){}
        submitVerifiedForm(form);
      } catch(e) {
        showError(modal, texts.error_generic);
      }
    }).catch(function(){
      showError(modal, texts.solving_error);
    });
  }

  // show loading spinner inside turnstile area (and return cleanup fn)
  function showLoadingInTurnstile(modal, text) {
    var wrap = modal.querySelector('#ec-turnstile-wrap');
    if (!wrap) return function(){};
    wrap.innerHTML = '';
    var box = document.createElement('div');
    box.style.cssText = 'display:flex;align-items:center;gap:10px';
    var spinner = document.createElement('div');
    spinner.style.cssText = 'width:18px;height:18px;border-radius:50%;border:3px solid #e6e9ef;border-top-color:#2563eb;animation:ec-spin 1s linear infinite';
    var txt = document.createElement('div');
    txt.style.cssText = 'font-size:14px;color:#374151';
    txt.textContent = text;
    box.appendChild(spinner);
    box.appendChild(txt);
    wrap.appendChild(box);
    // keyframes (once)
    if (!document.getElementById('ec-spin-style')) {
      var ss = document.createElement('style'); ss.id = 'ec-spin-style';
      ss.textContent = '@keyframes ec-spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}';
      document.head.appendChild(ss);
    }
    // cleanup function: remove box
    return function(){ try { if (box && box.parentNode) box.parentNode.removeChild(box); } catch(e){} };
  }

  // show turnstile widget and handle token
  function openModalAndRender(form) {
    loadTurnstileScript().then(function(){
      var modal = buildModal();
      var cont = modal.querySelector('#ec-turnstile-wrap');
      var texts = getTexts();
      // show spinner and get cleanup function
      var cleanupSpinner = showLoadingInTurnstile(modal, texts.loading_text);

      try {
        // create a dedicated container for the widget so we can ensure spinner is removed immediately
        cont.innerHTML = '';
        var widgetContainer = document.createElement('div');
        widgetContainer.style.cssText = 'display:flex;justify-content:center';
        cont.appendChild(widgetContainer);
        // Immediately remove spinner (cleanup)
        cleanupSpinner();

        // render into the widgetContainer; if render succeeds, the widget will appear and spinner won't remain
        window._ec_turnstile_widget = turnstile.render(widgetContainer, {
          sitekey: window.ecCaptchaPage.turnstile_sitekey || '',
          callback: function(token){
            clearError(modal);
            if (isEmailVerificationEnabled()) {
              sendVerification(token, form, modal);
            } else {
              verifyTurnstileOnly(token, form, modal);
            }
          },
          'error-callback': function(){
            showError(modal, texts.solving_error);
          },
          'expired-callback': function(){
            // expired widget; let user re-solve
          }
        });
      } catch(e) {
        // ensure spinner cleaned and show error
        cleanupSpinner();
        clearError(modal);
        showError(modal, texts.solving_error);
      }
    }).catch(function(err){
      alert('Turnstile load failed, please refresh and try again.');
    });
  }

  // Send verification: call admin-ajax ec_send_verification with turnstile token + name/email from form
  function sendVerification(turnstileToken, form, modal) {
    var texts = getTexts();
    var nameVal = getFormNameValue(form);
    var emailVal = getFormEmailValue(form);

    if (!emailVal) {
      showError(modal, texts.no_email);
      return;
    }

    // show sending note
    showSentNote(modal, replaceEmailToken(texts.sending, emailVal));

    var data = new FormData();
    data.append('action', 'ec_send_verification');
    data.append('ec_page_nonce', window.ecCaptchaPage.page_nonce || '');
    data.append('page_id', window.ecCaptchaPage.page_id || 0);
    data.append('turnstile_token', turnstileToken);
    data.append('to_email', emailVal);
    data.append('to_name', nameVal);

    fetch( window.ecCaptchaPage.ajax_url, {
      method: 'POST',
      credentials: 'same-origin',
      body: data
    }).then(function(res){ return res.json(); }).then(function(json){
      if (!json) { showError(modal, texts.error_send); return; }
      if (!json.success) {
        var msg = (json.data && json.data.message) ? json.data.message : (json.message || texts.error_send);
        showError(modal, msg);
        return;
      }
      var payload = json.data || {};
      var cachedState = saveCachedVerification(form, emailVal, payload);
      modal.dataset.ecVerificationId = payload.verification_id || '';
      showCodeEntryState(modal, emailVal, replaceEmailToken(payload.reused ? (texts.reused || texts.sent) : texts.sent, emailVal));
      bindVerifyButton(modal, form, emailVal, cachedState);
      bindResendButton(modal, form, emailVal, cachedState);
    }).catch(function(err){
      showError(modal, texts.error_send);
    });
  }

  // call admin-ajax ec_check_verification with verification_id + code
  function checkVerification(verification_id, code, form, modal, emailVal, cachedState) {
    var texts = getTexts();
    var verifyBtn = modal.querySelector('#ec-verify-btn');
    if (!verification_id) { showError(modal, texts.error_generic); return; }
    var data = new FormData();
    data.append('action', 'ec_check_verification');
    data.append('ec_page_nonce', window.ecCaptchaPage.page_nonce || '');
    data.append('page_id', window.ecCaptchaPage.page_id || 0);
    data.append('verification_id', verification_id);
    data.append('code', code);

    fetch( window.ecCaptchaPage.ajax_url, {
      method: 'POST',
      credentials: 'same-origin',
      body: data
    }).then(function(res){ return res.json(); }).then(function(json){
      if (!json) {
        setButtonPending(verifyBtn, false, texts.verify_loading, texts.verify_btn);
        showError(modal, texts.error_verify);
        return;
      }
      if (!json.success) {
        setButtonPending(verifyBtn, false, texts.verify_loading, texts.verify_btn);
        if (json.data && json.data.error_code === 'expired') {
          clearCachedVerification(form, emailVal, cachedState);
        }
        var msg = (json.data && json.data.message) ? json.data.message : (json.message || texts.error_verify);
        showError(modal, msg);
        return;
      }
      // verification success: inject ec_verified_id hidden input and submit form
      try {
        clearCachedVerification(form, emailVal, cachedState);
        form._ecAllowVerifiedSubmit = true;
        setHiddenInput(form, 'ec_verified_id', verification_id);
        // remove modal
        if (modal._ecResendTimer) window.clearInterval(modal._ecResendTimer);
        try { modal.parentNode.removeChild(modal); } catch(e){}
        submitVerifiedForm(form);
      } catch(e){ console && console.error && console.error('final submit error', e); }
    }).catch(function(err){
      setButtonPending(verifyBtn, false, texts.verify_loading, texts.verify_btn);
      showError(modal, texts.error_verify);
    });
  }

  document.addEventListener('click', function(evt){
    try {
      var submitter = findSubmitterCandidate(evt.target);
      if (submitter && submitter.form) {
        submitter.form._ecLastSubmitter = submitter;
      }
    } catch(e){}
  }, true);

  // intercept native submit: if no ec_verified_id present -> prevent and open modal+turnstile
  document.addEventListener('submit', function(evt){
    try {
      var form = evt.target;
      if (!form || form.nodeName !== 'FORM') {
        var el = evt.target; while (el && el.nodeName !== 'FORM') el = el.parentNode; form = el;
        if (!form) return;
      }
      function isSearchForm(f){
        if (!f) return false;
        try {
            // prefer classList check for exact class
            if (f.classList && f.classList.contains && f.classList.contains('search-form')) return true;
            // fallback: check class attribute substring (covers cases like "foo-search-form" if desired)
            var cls = f.getAttribute && f.getAttribute('class');
            if (!cls) return false;
            return cls.indexOf('search-form') !== -1;
        } catch(e) {
            return false;
        }
      }
      if (isSearchForm(form)) return;
      var verifiedInput = form.querySelector('input[name="ec_verified_id"], input[name="ec_turnstile_verified_id"]');
      if (verifiedInput) {
        if (form._ecAllowVerifiedSubmit) {
          form._ecAllowVerifiedSubmit = false;
          return;
        }
        if (verifiedInput.parentNode) verifiedInput.parentNode.removeChild(verifiedInput);
      }

      form._ecPendingSubmitter = evt.submitter || form._ecLastSubmitter || null;

      if (isEmailVerificationEnabled()) {
        var emailVal = getFormEmailValue(form);
        if (!looksLikeEmail(emailVal)) {
          form._ecPendingSubmitter = null;
          return;
        }
        evt.preventDefault(); evt.stopImmediatePropagation();
        var cachedState = loadCachedVerification(form, emailVal);
        if (cachedState) {
          openCodeEntryModal(form, emailVal, cachedState);
          return;
        }
      } else {
        evt.preventDefault(); evt.stopImmediatePropagation();
      }
      // show modal and render turnstile then send verification
      openModalAndRender(form);
    } catch(e){}
  }, true);

