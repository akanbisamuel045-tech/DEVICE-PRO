<style>/* widget: Before After */

#uc_uc_before_after_elementor_a198949 {
	box-sizing: border-box;
	cursor: pointer;
	margin: 0;
	overflow: hidden;
	padding: 0;
	position: relative;
	user-select: none;
}

#uc_uc_before_after_elementor_a198949 img{
	isolation: unset;
}  

#uc_uc_before_after_elementor_a198949 * {
	box-sizing: inherit;
}

#uc_uc_before_after_elementor_a198949 ::after,
#uc_uc_before_after_elementor_a198949 ::before {
	box-sizing: inherit;
}

#uc_uc_before_after_elementor_a198949 img,
#uc_uc_before_after_elementor_a198949 picture>img {
	max-width: none;
}

#uc_uc_before_after_elementor_a198949>img,
#uc_uc_before_after_elementor_a198949>picture>img {
	display: block;
	width: 100%;
}

#uc_uc_before_after_elementor_a198949>div:first-child,
picture #uc_uc_before_after_elementor_a198949>div {
	
	left: 0;
	overflow: hidden;
	position: absolute;
	top: 0;
      	width: 50%;
    height: 100%;
  		
  		
}

#uc_uc_before_after_elementor_a198949 .cocoen-drag {
	position: absolute;
}

#uc_uc_before_after_elementor_a198949 .cocoen-drag::before {
	content: '';
  	position: absolute;
  	  
}

/* general arrows settings */
	#uc_uc_before_after_elementor_a198949 .cocoen-drag::before,
    #uc_uc_before_after_elementor_a198949 .cocoen-drag::after{
